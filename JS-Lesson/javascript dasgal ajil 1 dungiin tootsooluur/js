function getGrade(score) {
    if  (score >= 90) return "A ~ Чи бол хамгийн мундаг<3 ";
    else if (score >= 80 )return "B ~ Жоохон хичээчихвэл яг болох гээд байна шүү броныжеймс<3";
    else if (score >= 70) return "C ~ Өгзөгөө чанга л хонгор минь ";
    else return "F ~ Өө юм авчихсан!";
    // TODO: if / else if --> "A", "B", "C", "F"
}
const isPassed = (score => score >= 70);
    // TODO: 70+ бол true
let passed = 0;
for (let s = 50; s <= 100; s +=10) {
    const ok = isPassed(s);
    console.log(`Оноо: ${s} --> ${getGrade(s)} (${ok ? "Тэнцсэн" : "Тэнцээгүй"})`);
    if (ok) passed++;
    // TODO: хэвлэх, passe-ийг тоолох 
}
console.log(`Тэнцсэн: ${passed}`);