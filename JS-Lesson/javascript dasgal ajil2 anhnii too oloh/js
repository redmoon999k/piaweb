function isPrime(n) {
    // TODO: n < 2 бол false
    if (n < 2) return false;
    // TODO: 2-оос n-1 хүртэл хуваагч хайх 
    for (let i = 2; i * i <= n; i++) {
        if (n % i === 0) return false;
    }
    return true;
    // TODO: олдохгүй бол true
}

let result = "";
let count = 0;
for (let n = 1; n <= 30; n++) {
    // TODO: анхны бол result-д залгах, count++ 
    if (isPrime(n)) {
        result += n + " ";
        count++;
    }
}
console.log(result. trim());
console.log(`Нийт ${count}`);
